# Copy to .env for local development. Never commit configured secrets.
# npm run postgres generates local experiment credentials and random application keys.
EXPERIMENT_DATABASE_URL=postgresql://queryotter:CHANGE_ME@127.0.0.1:55432/queryotter
# Leave unset for the local SQLite application store. Cloud mode requires PostgreSQL.
# JOB_DATABASE_URL=postgresql://qot_app_runtime:CHANGE_ME@YOUR_NEON_HOST/queryotter_app?sslmode=verify-full&channel_binding=require
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b
MODEL_API_KEY=
SERVICE_TOKEN=GENERATE_RANDOM_32_BYTES
SESSION_SECRET=GENERATE_RANDOM_32_BYTES
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store separately from database data. Rotation requires re-encrypting existing encrypted data.
ENCRYPTION_KEY=GENERATE_FERNET_KEY
# Optional operator access, distinct from OAuth identities.
ADMIN_PASSWORD=SET_STRONG_PASSWORD
# Canonical HTTPS frontend on Railway. Local Vite supplies its authenticated origin when unset.
APP_ORIGIN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Global public model operations per UTC day; cached reports require no model calls.
DEMO_DAILY_LIMIT=6
USER_DAILY_TOKEN_LIMIT=20000
JOB_SECONDS=180
STATEMENT_TIMEOUT_MS=3000
PORT=8000
# Vercel server-side variables only; never prefix these with VITE_.
CONNECTOR_URL=https://YOUR_API_WORKER.up.railway.app
# Connector-machine variables: see docs/local-connector.md.
QOT_CONNECTOR_ORIGIN=https://queryotter.vercel.app
QOT_CONNECTOR_ID=
QOT_CONNECTOR_TOKEN=
# QOT_TEST_NETWORKS=1 is permitted ONLY for isolated loopback fixtures.
# backend.cloud refuses to start when that variable is set.
