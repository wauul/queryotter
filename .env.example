# Copy to .env for local development. Never commit configured secrets.
# npm run postgres generates local experiment credentials and random application keys.
EXPERIMENT_DATABASE_URL=postgresql://queryotter:CHANGE_ME@127.0.0.1:55432/queryotter
# Leave unset for the local SQLite application store. Cloud mode requires PostgreSQL.
# JOB_DATABASE_URL=postgresql://qot_app_runtime:CHANGE_ME@YOUR_NEON_HOST/queryotter_app?sslmode=verify-full&channel_binding=require
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b
MODEL_API_KEY=
# Optional content-free Langfuse model telemetry (worker/server only).
# Both credentials AND explicit opt-in are required. No automatic callbacks.
QOT_LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
SERVICE_TOKEN=GENERATE_RANDOM_32_BYTES
SESSION_SECRET=GENERATE_RANDOM_32_BYTES
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store separately from database data. Rotation requires re-encrypting existing encrypted data.
ENCRYPTION_KEY=GENERATE_FERNET_KEY
# Optional operator access, distinct from OAuth identities.
ADMIN_PASSWORD=SET_STRONG_PASSWORD
# Canonical HTTPS frontend on Railway. Local Vite supplies its authenticated origin when unset.
APP_ORIGIN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Global public model operations per UTC day; cached reports require no model calls.
DEMO_DAILY_LIMIT=6
USER_DAILY_TOKEN_LIMIT=20000
JOB_SECONDS=180
STATEMENT_TIMEOUT_MS=3000
PORT=8000
# Vercel server-side variables only; never prefix these with VITE_.
CONNECTOR_URL=https://YOUR_API_WORKER.up.railway.app
# Connector-machine variables: see docs/local-connector.md.
QOT_CONNECTOR_ORIGIN=https://queryotter.vercel.app
QOT_CONNECTOR_ID=
QOT_CONNECTOR_TOKEN=
# QOT_TEST_NETWORKS=1 is permitted ONLY for isolated loopback fixtures.
# backend.cloud refuses to start when that variable is set.

# Sentry is disabled independently in each component when its DSN is absent.
# Reuse existing projects when appropriate; browser and server keys stay distinct.
VITE_SENTRY_DSN=
SENTRY_PROXY_DSN=
SENTRY_PYTHON_DSN=
# Supported: development, test, staging, preview, production. Set per deployment.
SENTRY_ENVIRONMENT=development
# Shared full Git SHA, or queryotter@<40-character SHA>, across all deployments.
# Vercel falls back to VERCEL_GIT_COMMIT_SHA; Railway to RAILWAY_GIT_COMMIT_SHA.
SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
# Browser release/environment are injected by Vite from the shared server values.
# Replay, profiling, telemetry logs and automatic model/DB instrumentation are disabled.
# No replay opt-in is implemented; do not add replay configuration without privacy review.

# BUILD/CI ONLY: upload browser source maps; never set these on Railway runtime.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Configured browser builds require all three above plus a Git release.
# Add the EXACT VITE_SENTRY_DSN ingestion origin to vercel.json connect-src first.
# Never name build secrets VITE_*. See docs/sentry.md for setup and smoke checks.
