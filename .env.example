# Generated locally by scripts/postgres.mjs; never commit real secrets.
EXPERIMENT_DATABASE_URL=postgresql://queryotter:CHANGE_ME@127.0.0.1:55432/queryotter
# openai-compatible supports Groq via https://api.groq.com/openai/v1
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b
MODEL_API_KEY=
SERVICE_TOKEN=GENERATE_RANDOM_32_BYTES
SESSION_SECRET=GENERATE_RANDOM_32_BYTES
ENCRYPTION_KEY=GENERATE_FERNET_KEY
ADMIN_PASSWORD=SET_STRONG_PASSWORD
# Public model runs per UTC day, globally. Cached reports cost nothing.
DEMO_DAILY_LIMIT=6
JOB_SECONDS=180
STATEMENT_TIMEOUT_MS=3000
