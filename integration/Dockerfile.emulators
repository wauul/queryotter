FROM node:22-bookworm-slim AS node
FROM eclipse-temurin:21-jre-jammy
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && npm install -g firebase-tools@15.32.0
RUN firebase setup:emulators:firestore && firebase setup:emulators:database
WORKDIR /emulators
COPY firebase.json firestore.rules database.rules.json ./
CMD ["node", "/usr/local/lib/node_modules/firebase-tools/lib/bin/firebase.js", "emulators:start", "--only", "firestore,database", "--project", "demo-queryotter"]
