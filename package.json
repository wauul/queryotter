  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/diff": "^7.0.2",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^5.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.9.9",
    "railway": "^3.12.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
